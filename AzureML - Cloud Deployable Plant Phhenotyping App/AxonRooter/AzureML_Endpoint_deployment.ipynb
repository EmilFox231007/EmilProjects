   "source": [
    "import json\n",
    "import base64\n",
    "\n",
    "# Path to your local image (change this!)\n",
    "image_path = r\"C:\\Users\\emilp\\Documents\\Buas_Y2\\Block_B\\data_sets\\Y2B_23\\images\\003_43-18-ROOT1-2023-08-08_pvdCherry_OD01_f6h1_01-Fish Eye Corrected.png\"\n",
    "\n",
    "# Output JSON file name\n",
    "output_json = \"test_payload.json\"\n",
    "\n",
    "# Read image and encode as base64\n",
    "with open(image_path, \"rb\") as img_file:\n",
    "    encoded = base64.b64encode(img_file.read()).decode(\"utf-8\")\n",
    "\n",
    "# Create JSON payload\n",
    "payload = {\"data\": encoded}\n",
    "\n",
    "# Write to file\n",
    "with open(output_json, \"w\") as f:\n",
    "    json.dump(payload, f)\n",
    "\n",
    "print(f\"✅ Created {output_json}\")\n"
   ]
